  "display": "standalone",
  "background_color": "#F9F8F6",
  "theme_color": "#C85A32",
  "orientation": "portrait",
  "categories": ["finance", "productivity", "utilities"],
  "shortcuts": [
    {
      "name": "Upload Statement",
