      "url": "/?upload=true",
      "icons": [{ "src": "favicon.svg", "sizes": "192x192" }]
    },
    {
      "name": "View Schemes",
      "short_name": "Schemes",
      "description": "Check eligible welfare schemes",
      "url": "/?view=schemes",
      "icons": [{ "src": "favicon.svg", "sizes": "192x192" }]
    },
    {
      "name": "Income Dashboard",
      "short_name": "Dashboard",
      "description": "View your income analytics and savings",
      "url": "/?view=dashboard",
      "icons": [{ "src": "favicon.svg", "sizes": "192x192" }]
    }
  ],
  "share_target": {
    "action": "/?share=true",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
